# --- Database Aiven PostgreSQL ---
DATABASE_URL=

# --- Auth JWT ---
JWT_SECRET=

# --- Email SMTP (Gmail, fase 2) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
